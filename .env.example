# Never add server secrets or Firebase Admin credentials to this app.
# Android emulators cannot use localhost for a backend on your computer.
# Use your LAN IP during local development, e.g. http://192.168.1.10:5000/api
EXPO_PUBLIC_API_URL=https://laundry.anushatechnologies.com/api
# Kept separate from the customer API. No staff token belongs in this app.
EXPO_PUBLIC_ADMIN_URL=https://laundry.anushatechnologies.com/admin
