{
  "expo": {
    "name": "LaundryFresh",
    "slug": "laundryfresh-customer",
    "version": "1.0.44",
    "icon": "./assets/brand-logo.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "laundryfresh",
    "newArchEnabled": true,
    "android": {
      "package": "com.laundry",
      "googleServicesFile": "./google-services.json",
      "versionCode": 44,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LaundryFresh uses your location to detect your delivery address, find nearby laundry services, and check service availability."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "orders",
          "color": "#16A34A"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FCF9F7",
          "image": "./assets/brand-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://laundry.anushatechnologies.com/api",
      "eas": {
        "projectId": "dd069378-41c0-45ea-917b-455411dc44b5"
      }
    },
    "owner": "anushabazaar"
  }
}
